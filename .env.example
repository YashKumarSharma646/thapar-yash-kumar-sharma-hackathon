# Copy to .env to override. Everything works with these defaults; API keys are optional.
INGEST_MODE=replay
# Simulated seconds per real second: the 47-day 2018 window plays in ~10 min
REPLAY_SPEED=7200
STRESS_IMPACT_THRESHOLD=7

# Optional live sources (leave empty to run fully offline)
NEWSAPI_KEY=
ALPHAVANTAGE_KEY=
